# ============================================================================
# DATABRICKS CONFIGURATION
# ============================================================================

DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_token_here

# Unity Catalog
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=finsight_ai

# SQL Warehouse
SQL_WAREHOUSE_ID=your_warehouse_id

# ============================================================================
# FINANCIAL DATA APIs
# ============================================================================

# Alpha Vantage (25 requests/day - FREE)
# ✅ CONFIGURADA - Ya la tienes
# URL: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# Financial Modeling Prep (250 requests/day - FREE)
# ✅ CONFIGURADA - Tu API key: fgx8EXmmbWI0g0C70PpA5PqSVhjPYmoR
# URL: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=fgx8EXmmbWI0g0C70PpA5PqSVhjPYmoR

# SEC Edgar (Unlimited - FREE, NO API KEY REQUIRED)
# ℹ️  OPCIONAL - SEC Edgar NO requiere API key
# Solo necesita User-Agent header en las requests
# Ejemplo: "User-Agent: YourCompany contact@example.com"
SEC_API_KEY=  # Dejar vacío, no se usa

# NewsAPI (100 requests/day - FREE)
# URL: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key

# Tavily (1000 requests/month - FREE)
# URL: https://tavily.com/
TAVILY_API_KEY=your_tavily_key

# ============================================================================
# LLM PROVIDER KEYS (for AI Gateway)
# ============================================================================

OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# ============================================================================
# AI GATEWAY ENDPOINTS (Unity Catalog)
# ============================================================================

AI_GATEWAY_SYNTHESIS=ai-gateway:/main.finsight_ai.synthesis
AI_GATEWAY_ANALYSIS=ai-gateway:/main.finsight_ai.analysis
AI_GATEWAY_EXTRACTION=ai-gateway:/main.finsight_ai.extraction

# ============================================================================
# VECTOR SEARCH
# ============================================================================

VECTOR_SEARCH_ENDPOINT=finsight_vector_search
VECTOR_SEARCH_INDEX=main.finsight_ai.documents_index

# ============================================================================
# MLFLOW (Databricks Native)
# ============================================================================

MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Users/shared/finsight-ai-experiments

# ============================================================================
# OPTIONAL: LANGSMITH TRACING
# ============================================================================

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=finsight-ai

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=false

# ============================================================================
# NOTAS IMPORTANTES:
# ============================================================================
#
# 1. **Alpha Vantage** (YA CONFIGURADA):
#    - Límite: 25 requests/día (gratis)
#    - Usa para: FinancialStatementWorker, EarningsWorker (básico)
#    - Endpoints: BALANCE_SHEET, INCOME_STATEMENT, CASH_FLOW, EARNINGS
#
# 2. **Financial Modeling Prep** (YA CONFIGURADA):
#    - Límite: 250 requests/día (gratis)
#    - Usa para: KeyRatiosWorker, EarningsWorker (completo)
#    - Endpoints: ratios-ttm, key-metrics-ttm, earnings-surprises
#    - Tu API key: fgx8EXmmbWI0g0C70PpA5PqSVhjPYmoR
#
# 3. **SEC Edgar** (NO REQUIERE API KEY):
#    - Límite: Ilimitado (gratis)
#    - Solo necesita User-Agent header
#    - Usa para: Filings (10-Q, 10-K), XBRL data alternativo
#    - Endpoints: data.sec.gov/api/xbrl/companyfacts/CIK{cik}.json
#
# 4. **ValuationWorker**:
#    - NO requiere API key adicional
#    - Usa datos de FinancialStatementWorker + KeyRatiosWorker
#    - Implementa DCF model in-house
#
# ============================================================================
